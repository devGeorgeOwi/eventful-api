// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String?
  googleId      String?  @unique
  role          Role     @default(USER)  // USER or CREATOR
  createdAt     DateTime @default(now())

  createdEvents Event[]  @relation("EventCreator")
  tickets       Ticket[]

  reminders     Reminder[]
  notificationLogs  NotificationLog[]
}

enum Role {
  USER
  CREATOR
}

model Event {
  id                String    @id @default(uuid())
  title             String
  description       String?
  date              DateTime
  location          String?
  price             Float     // in smallest currency unit (kobo) for Paystack? We'll use Naira kobo
  capacity          Int       // max tickets
  creatorId         String
  creator           User      @relation("EventCreator", fields: [creatorId], references: [id])
  createdAt         DateTime  @default(now())
  
  tickets           Ticket[]
  reminders         Reminder[]
  notificationLogs  NotificationLog[]
  analyticsSnapshot EventAnalytics? // store precomputed numbers for speed
}

model Ticket {
  id           String   @id @default(uuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id])
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  qrCodeText   String   @unique  // unique string embedded in QR
  isUsed       Boolean  @default(false) // scanned at entrance?
  purchasedAt  DateTime @default(now())
  paymentRef   String   @unique  // Paystack transaction reference
}

model Reminder {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  userId    String?  // null for global (creator) reminders
  user      User?    @relation(fields: [userId], references: [id])
  delta     String   // e.g., "1d", "1w" before event date
  type      String   // CREATOR_SET or USER_SET
  createdAt DateTime  @default(now())

  @@unique([eventId, userId, type])   // prevents duplicates
}

model NotificationLog {
  id      String    @id @default(uuid())
  userId  String
  user    User      @relation(fields: [userId], references: [id])
  eventId String
  event   Event     @relation(fields: [eventId], references:  [id])
  message String
  sentAt  DateTime  @default(now())
}

enum ReminderType {
  CREATOR_SET
  USER_SET
}

model Payment {
  id          String   @id @default(uuid())
  userId      String
  eventId     String
  amount      Float
  status      String   @default("pending") // "pending", "success", "failed"
  reference   String   @unique
  paystackRef String?
  createdAt   DateTime @default(now())
}

model EventAnalytics {
  id            String   @id @default(uuid())
  eventId       String   @unique
  event         Event    @relation(fields: [eventId], references: [id])
  totalTicketsBought Int
  totalAttendees     Int  // scanned tickets
  lastUpdated  DateTime @updatedAt
}